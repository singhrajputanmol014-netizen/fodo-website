# FODO Admin ▸ Client Emails (website v54.2): environment variables.
# Set these in Cloudflare Pages ▸ fodo-website ▸ Settings ▸ Variables and secrets (Production), then redeploy.
# Never put real values in this file, in code or in the browser.

# Required. Resend API key (resend.com ▸ API Keys, "Sending access", domain fodo.co.in). Add as a SECRET.
# The site already uses it for login codes and Studio keys, so it may be set already.
RESEND_API_KEY=

# Optional. Who the client sees as the sender. The address must be on a domain verified in Resend (fodo.co.in).
# Default: Rohit · FODO <rohit@fodo.co.in>
CLIENT_MAIL_FROM=Rohit · FODO <rohit@fodo.co.in>

# Optional. Where client replies go. Default: rohit@fodo.co.in
CLIENT_MAIL_REPLY_TO=rohit@fodo.co.in

# Optional. Max real client emails per hour (test sends don't count). Default: 20
CLIENT_MAIL_HOURLY=20

# Optional. Secret used to sign unsubscribe links. Default: derived from RESEND_API_KEY.
# Set it once and keep it: changing it makes old unsubscribe links invalid. Add as a SECRET.
OPTOUT_SECRET=
